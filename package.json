{
  "name": "pagr-sdk",
  "version": "1.0.0",
  "description": "TypeScript client for the Pagr document rendering API",
  "keywords": [
    "pagr",
    "pdf",
    "rendering",
    "documents",
    "templates"
  ],
  "license": "Apache-2.0",
  "author": "Metanous",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metanous-BV/pagr-typescript.git"
  },
  "homepage": "https://github.com/Metanous-BV/pagr-typescript",
  "bugs": {
    "url": "https://github.com/Metanous-BV/pagr-typescript/issues"
  },
  "type": "commonjs",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.8.1",
    "tsup": "^8.3.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
